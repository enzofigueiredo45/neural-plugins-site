PORT=4173

# Sessions/security - use a long random value in production
SESSION_SECRET=troque-por-um-segredo-longo-com-32-ou-mais-caracteres
REDIS_URL=redis://localhost:6379
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=3

# Stripe - prefer a restricted live key and never commit real values to git
STRIPE_SECRET_KEY=rk_live_substitua_no_painel_da_hospedagem
STRIPE_PRICE_NEURAL_X=price_substitua_pacote_neural_x
STRIPE_PRICE_FL_STUDIO=price_substitua_fl_studio
STRIPE_PRICE_REAPER=price_substitua_reaper
STRIPE_WEBHOOK_SECRET=whsec_substitua_pelo_segredo_do_webhook

# E-mails transacionais (Resend)
RESEND_API_KEY=re_substitua_no_painel_da_hospedagem
# Use onboarding@resend.dev somente em testes. Em produção, use um domínio verificado.
EMAIL_FROM=Neural X <suporte@neuralxplugins.com.br>
EMAIL_REPLY_TO=figueiredoenzo57@gmail.com
EMAIL_SUPPORT_TO=figueiredoenzo57@gmail.com

# Fulfillment - URLs HTTPS sem credenciais; deixe vazio até ter um acesso real e verificado
PRODUCT_ACCESS_URL_NEURAL_X=
PRODUCT_ACCESS_URL_FL_STUDIO=
PRODUCT_ACCESS_URL_REAPER=
# automatic = acesso direto; request = cliente solicita permissão no provedor
PRODUCT_ACCESS_MODE_NEURAL_X=request
PRODUCT_ACCESS_MODE_FL_STUDIO=automatic
PRODUCT_ACCESS_MODE_REAPER=automatic

# Anti-abuse
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
# SEO / search verification (optional; usually DNS verification is better)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
